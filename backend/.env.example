APP_ENV=development
DATABASE_URL=postgresql+asyncpg://orbit:orbit@db:5432/orbit
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# eSewa ePay v2 — real payment collection (initiate/verify), see
# app/services/payment_service.py. EPAYTEST / the secret below are eSewa's
# own published sandbox test merchant credentials (documented publicly for
# developer testing), not anything account-specific. ESEWA_FORM_URL and
# ESEWA_STATUS_URL default to the correct sandbox hosts and rarely need
# overriding — only the merchant/secret change between sandbox and production.
ESEWA_MODE=sandbox
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Khalti ePayment v2 — real payment collection (initiate/verify).
KHALTI_INITIATE_URL=https://dev.khalti.com/api/v2/epayment/initiate/
KHALTI_VERIFY_URL=https://dev.khalti.com/api/v2/epayment/lookup/
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=

# Backend's own externally-reachable URL — eSewa/Khalti redirect back here
# after checkout. Must be a real public host once this isn't localhost.
PUBLIC_BASE_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# SMTP, used to email customer login/register one-time codes. SMTP_USER must
# be the full mailbox address (e.g. your Gmail address), not a display name.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Groq (OpenAI-compatible) chat completions, used by the mobile AI assistant.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_RATE_LIMIT_PER_MINUTE=10

# Seed admin account, created idempotently on startup (skipped if it exists).
ADMIN_EMAIL=orbit@admin.com
ADMIN_PASSWORD=Orbit@2026
ADMIN_NAME=Orbit Admin

# Cloudinary, used to sign direct-to-Cloudinary uploads (avatars, documents).
# The secret stays server-side — it's never sent to admin/mobile.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
