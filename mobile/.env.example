# Copy to .env. Expo inlines EXPO_PUBLIC_* vars into the bundle at start time
# — restart with `npx expo start -c` after changing this.
#
# - Web preview / iOS simulator / Android emulator on this same machine:
#   http://localhost:8000 works.
# - Physical device via Expo Go: "localhost" means the phone itself, not
#   your computer. Use your computer's LAN IP instead (same WiFi network),
#   e.g. http://192.168.1.79:8000 — find yours with `hostname -I` (Linux/Mac)
#   or `ipconfig` (Windows).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
